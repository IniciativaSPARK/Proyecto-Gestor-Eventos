# Configuración del Servidor
PORT=8000
ENVIRONMENT=development

# Base de Datos (Deben coincidir con los datos del docker-compose.yml local)
DB_USER=spark_admin
DB_PASSWORD=spark_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spark_eventos

# URL de conexión directa para SQLAlchemy / Alembic
DATABASE_URL=postgresql://spark_admin:spark_secure_password@localhost:5432/spark_eventos

# Seguridad (Llenar con strings aleatorios para desarrollo local)
JWT_SECRET=spark_local_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Almacenamiento AWS S3 (Vacío por ahora, se usará en producción)
AWS_ACCESS_KEY_ID=mock_local_key
AWS_SECRET_ACCESS_KEY=mock_local_secret
AWS_STORAGE_BUCKET_NAME=spark-eventos-assets